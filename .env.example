# ------------------------------------------------------------------
# Variáveis de ambiente opcionais (copie para .env.local)
# ------------------------------------------------------------------

# Endereço oculto do painel de conteúdo (padrão: /painel-interno)
ADMIN_PATH=/painel-interno

# URL final do site publicado (usada no SEO, sitemap e links canônicos).
# Se vazio, usa o campo meta.siteUrl de content/site-config.json
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Chave extra de proteção da API de conteúdo (opcional).
# Se definida, o painel precisa enviar o cabeçalho x-admin-key.
ADMIN_KEY=

# Código de verificação do Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
